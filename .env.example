# ====================================================================
# Cloudflare Credentials Configuration
# ====================================================================

# 1. Cloudflare Account ID (Found on right side of Cloudflare Dashboard)
CLOUDFLARE_ACCOUNT_ID="your_account_id_here"

# 2. Cloudflare API Token (With D1 and R2 Edit Permissions)
CLOUDFLARE_API_TOKEN="your_api_token_here"

# 3. Cloudflare D1 Database
CLOUDFLARE_D1_DATABASE_NAME="gvd_autocare_db"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_uuid_here"

# 4. Cloudflare R2 Bucket
CLOUDFLARE_R2_BUCKET_NAME="gvd-inspection-photos"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-yourbucket.r2.dev"
